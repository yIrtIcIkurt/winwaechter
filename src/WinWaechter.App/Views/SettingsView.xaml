<UserControl x:Class="WinWaechter.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinWaechter.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource Text.PageTitle}" Text="Einstellungen" />

            <!-- ===== Version and update ===== -->
            <TextBlock Margin="0,30,0,0" Style="{StaticResource Text.Section}" Text="Version und Update" />
            <Border Margin="0,12,0,0" Style="{StaticResource SurfaceBox}" Padding="18,14" DataContext="{Binding Update}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Abbrechen" Margin="0,0,8,0" Command="{Binding CheckCancelCommand}"
                                    Visibility="{Binding CheckCommand.IsRunning, Converter={StaticResource Vis}}" />
                            <Button Content="Nach Updates suchen" Command="{Binding CheckCommand}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="{StaticResource WeightSemiLight}"
                                       Text="{Binding DataContext.VersionText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Small}" Text="{Binding StatusText}"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Margin="0,14,0,0" Visibility="{Binding IsAvailable, Converter={StaticResource Vis}}">
                        <Rectangle Style="{StaticResource ScaleRule}" />
                        <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Label}" Text="Änderungen" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Prose}" Foreground="{DynamicResource Ink}" Text="{Binding Notes}" />
                        <Border Margin="0,12,0,0" Style="{StaticResource Notice}" Visibility="{Binding ShowAdminNotice, Converter={StaticResource Vis}}">
                            <TextBlock Foreground="{DynamicResource Watch}" TextWrapping="Wrap" Text="{Binding AdminNotice}" />
                        </Border>
                        <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Small}" Foreground="{DynamicResource Watch}" Text="{Binding GateHint}"
                                   Visibility="{Binding GateHint, Converter={StaticResource Vis}}" />
                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                            <Button Content="Herunterladen und prüfen" Margin="0,0,8,0" Command="{Binding DownloadCommand}" />
                            <Button Content="Abbrechen" Margin="0,0,8,0" Command="{Binding DownloadCancelCommand}"
                                    Visibility="{Binding DownloadCommand.IsRunning, Converter={StaticResource Vis}}" />
                            <Button Style="{StaticResource Button.Primary}" Content="Jetzt installieren" Command="{Binding InstallCommand}"
                                    Visibility="{Binding IsVerifiedReady, Converter={StaticResource Vis}}" />
                        </StackPanel>
                        <ProgressBar Margin="0,12,0,0" Style="{StaticResource Scale}" Value="{Binding DownloadPercent}"
                                     Visibility="{Binding DownloadCommand.IsRunning, Converter={StaticResource Vis}}"
                                     AutomationProperties.Name="Download-Fortschritt" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <CheckBox Margin="0,14,0,0" Style="{StaticResource Toggle}" IsChecked="{Binding CheckUpdatesOnStart, Mode=TwoWay}" MaxWidth="560" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="Beim Start nach Updates suchen" />
                    <TextBlock Style="{StaticResource Text.Small}" Text="Fragt nur GitHub nach der neuesten Version. Heruntergeladen wird erst auf Klick." />
                </StackPanel>
            </CheckBox>

            <!-- ===== Rules ===== -->
            <TextBlock Margin="0,34,0,0" Style="{StaticResource Text.Section}" Text="Regeln" />
            <Border Margin="0,12,0,0" Style="{StaticResource SurfaceBox}" Padding="18,12">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" Content="Regeln aktualisieren"
                            Command="{Binding UpdateRulesCommand}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Typography.NumeralAlignment="Tabular" Text="{Binding RulesText}" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Small}" TextWrapping="Wrap" Text="{Binding RulesStatus}"
                                   Visibility="{Binding RulesStatus, Converter={StaticResource Vis}}" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Prose}" FontSize="{StaticResource SizeSmall}"
                       Text="Die Regeln sagen, was geschützt ist und was als entbehrlich gilt. Neue Regeln kommen signiert von GitHub, können den Schutz nur erweitern und gelten ab dem nächsten Start." />

            <!-- ===== Ablage ===== -->
            <TextBlock Margin="0,34,0,0" Style="{StaticResource Text.Section}" Text="Ablage" />
            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="Automatisch leeren nach" />
                <TextBox Margin="10,0,10,0" Width="64" TextAlignment="Right" Typography.NumeralAlignment="Tabular"
                         Text="{Binding AblageDaysText, UpdateSourceTrigger=LostFocus}" KeyDown="OnAblageDaysKeyDown" AutomationProperties.Name="Tage bis zum automatischen Leeren" />
                <TextBlock VerticalAlignment="Center" Text="Tagen" />
            </StackPanel>
            <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Small}" Foreground="{DynamicResource Alarm}" Text="{Binding AblageDaysError}"
                       Visibility="{Binding AblageDaysError, Converter={StaticResource Vis}}" />
            <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Prose}" FontSize="{StaticResource SizeSmall}"
                       Text="Wird mit Eingabe oder beim Verlassen des Feldes gespeichert und gilt ab dem nächsten Start. Erst das Leeren der Ablage löscht Dateien endgültig." />

            <!-- ===== Folders ===== -->
            <TextBlock Margin="0,34,0,0" Style="{StaticResource Text.Section}" Text="Ordner" />
            <Border Margin="0,12,0,0" Style="{StaticResource SurfaceBox}">
                <StackPanel>
                    <Border Style="{StaticResource RowDivider}" Padding="18,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="16,0,0,0" Content="Öffnen" Command="{Binding OpenDataFolderCommand}"
                                    AutomationProperties.Name="Datenordner öffnen" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Daten (Sitzungen, Ablage, Updates)" />
                                <TextBlock Style="{StaticResource Text.Path}" Text="{Binding DataFolder}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Padding="18,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="16,0,0,0" Content="Öffnen" Command="{Binding OpenLogFolderCommand}"
                                    AutomationProperties.Name="Protokollordner öffnen" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Protokolle (7 Tage)" />
                                <TextBlock Style="{StaticResource Text.Path}" Text="{Binding LogFolder}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>
            <TextBlock Margin="0,14,0,0" Style="{StaticResource Text.Small}" Text="{Binding ModeText}" />

            <!-- ===== About ===== -->
            <TextBlock Margin="0,34,0,0" Style="{StaticResource Text.Section}" Text="Über WinWächter" />
            <StackPanel Margin="0,12,0,0">
                <TextBlock Text="{x:Static vm:SettingsViewModel.AuthorText}" />
                <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Small}" Typography.NumeralAlignment="Tabular" Text="{Binding VersionText}" />
                <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Small}" Text="Projekt auf GitHub" />
                <StackPanel Orientation="Horizontal">
                    <!-- selectable text, not a link: the elevated app never opens a browser -->
                    <TextBox Margin="-8,0,0,0" Padding="8,5" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                             Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center"
                             Text="{x:Static vm:SettingsViewModel.RepositoryUrl}" AutomationProperties.Name="Adresse des Projekts auf GitHub" />
                    <Button Margin="4,0,0,0" Style="{StaticResource Button.Quiet}" Content="Link kopieren"
                            Command="{Binding CopyRepositoryLinkCommand}" AutomationProperties.Name="Link zum Projekt kopieren" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Small}"
                               Text="{Binding LinkCopyStatus}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
