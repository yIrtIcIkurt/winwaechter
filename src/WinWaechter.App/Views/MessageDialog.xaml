<Window x:Class="WinWaechter.App.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" MaxHeight="640" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}"
        FontFamily="{StaticResource TextFont}" FontSize="{StaticResource SizeBody}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <DockPanel Margin="28,22,28,20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="ConfirmButton" Margin="0,0,8,0" MinWidth="110" Click="OnConfirm" />
            <Button x:Name="CancelButton" MinWidth="110" IsCancel="True" Content="Abbrechen" />
        </StackPanel>
        <StackPanel>
            <TextBlock x:Name="Heading" Style="{StaticResource Text.Section}" FontSize="20" TextWrapping="Wrap" />
            <TextBlock x:Name="Message" Margin="0,10,0,0" Style="{StaticResource Text.Body}" LineHeight="21" />
            <Border x:Name="ItemsFrame" Margin="0,14,0,0" Style="{StaticResource SurfaceBox}" Visibility="Collapsed">
                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl x:Name="ItemsList" Margin="14,8" Focusable="False" ItemTemplate="{StaticResource ReasonLine}" />
                </ScrollViewer>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
