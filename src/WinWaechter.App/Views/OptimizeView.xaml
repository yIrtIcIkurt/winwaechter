<UserControl x:Class="WinWaechter.App.Views.OptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Margin="{StaticResource PagePadding}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Abbrechen" Margin="0,0,8,0" Command="{Binding ScanCancelCommand}"
                            Visibility="{Binding ScanCommand.IsRunning, Converter={StaticResource Vis}}" />
                    <Button Style="{StaticResource Button.Primary}" Content="Prüfen" Command="{Binding ScanCommand}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="Optimieren" />
            </DockPanel>
            <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Prose}"
                       Text="Vorschläge mit Begründung. Vorausgewählt ist nur, was die Regelliste als entbehrlich kennt, dazu alte Temp-Dateien, Caches und verwaiste Einträge. Alte Installer, verwaiste Ordner und Unbekanntes erscheinen ohne Häkchen." />
            <StackPanel Margin="0,18,0,0" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}">
                <ProgressBar Style="{StaticResource Scale}" IsIndeterminate="True" />
                <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Small}" Text="{Binding ProgressText}"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </StackPanel>

        <!-- Footer with the apply action -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Canvas}"
                Padding="32,12,32,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Abbrechen" Margin="0,0,8,0" Command="{Binding ApplyCancelCommand}"
                            Visibility="{Binding ApplyCommand.IsRunning, Converter={StaticResource Vis}}" />
                    <Button Style="{StaticResource Button.Primary}" Content="{Binding ApplyText}" Command="{Binding ApplyCommand}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Text.Small}" Foreground="{DynamicResource Watch}" Text="{Binding AdminNotice}"
                               Visibility="{Binding ShowAdminNotice, Converter={StaticResource Vis}}" />
                    <TextBlock Style="{StaticResource Text.Small}" Foreground="{DynamicResource Watch}" Text="{Binding GateHint}"
                               Visibility="{Binding GateHint, Converter={StaticResource Vis}}" />
                    <TextBlock Style="{StaticResource Text.Small}" Text="{Binding LastSummary}"
                               Visibility="{Binding LastSummary, Converter={StaticResource Vis}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Findings -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="32,0,32,24">
                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,8,0,0"
                           Visibility="{Binding HasScanned, Converter={StaticResource Vis}, ConverterParameter=not}"
                           Text="Noch nicht geprüft. „Prüfen“ liest Autostarts, Dienste, Aufgaben, Temp-Dateien, Browser- und Windows-Caches, alte Installer und Deinstallationsreste, ohne etwas zu ändern." />
                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,8,0,0"
                           Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}"
                           Text="Nichts gefunden, was sich gefahrlos ändern ließe." />

                <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,8,0,18">
                                <StackPanel Margin="2,0,0,8">
                                    <DockPanel>
                                        <!-- group total, right-aligned with the row sizes -->
                                        <TextBlock DockPanel.Dock="Right" Margin="16,0,16,0" VerticalAlignment="Bottom"
                                                   Style="{StaticResource Text.Readout}" FontSize="{StaticResource SizeSection}"
                                                   Text="{Binding SizeText}" Visibility="{Binding SizeText, Converter={StaticResource Vis}}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Text.Section}" Text="{Binding Title}" />
                                            <TextBlock Margin="10,0,0,0" Style="{StaticResource Text.Label}" VerticalAlignment="Bottom" Padding="0,0,0,2"
                                                       Typography.NumeralAlignment="Tabular" Text="{Binding Items.Count}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Small}" MaxWidth="{StaticResource ProseWidth}"
                                               HorizontalAlignment="Left" Text="{Binding Hint}"
                                               Visibility="{Binding Hint, Converter={StaticResource Vis}}" />
                                </StackPanel>
                                <Border Style="{StaticResource SurfaceBox}">
                                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False" Margin="0,0,0,-1">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource RowDivider}" Padding="16,12,16,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox VerticalAlignment="Top" Margin="0,1,14,0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  IsEnabled="{Binding CanSelect}" AutomationProperties.Name="{Binding Title}" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Path}" Text="{Binding Location}" />
                                                            <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Small}" Text="{Binding ChangeText}"
                                                                       Visibility="{Binding ChangeText, Converter={StaticResource Vis}}" />
                                                            <Expander Margin="0,6,0,0" Style="{StaticResource Reasons}" Header="{Binding ReasonSummary}">
                                                                <ItemsControl ItemsSource="{Binding Reasons}" ItemTemplate="{StaticResource ReasonLine}" Focusable="False" />
                                                            </Expander>
                                                            <!-- a cache blocked by the running browser (4.9) -->
                                                            <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="Browser schließen und leeren"
                                                                    Visibility="{Binding CanCloseBrowser, Converter={StaticResource Vis}}"
                                                                    Command="{Binding DataContext.CloseBrowserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    AutomationProperties.Name="{Binding Title, StringFormat={}{0}: Browser schließen und leeren}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Margin="16,0,0,0" HorizontalAlignment="Right">
                                                            <ContentControl Style="{StaticResource Chip}" Tag="{Binding RatingTone}" Content="{Binding RatingText}"
                                                                            HorizontalAlignment="Right" />
                                                            <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Small}" HorizontalAlignment="Right"
                                                                       Typography.NumeralAlignment="Tabular" Text="{Binding SizeText}"
                                                                       Visibility="{Binding SizeText, Converter={StaticResource Vis}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
