<Window x:Class="WinWaechter.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinWaechter.App.ViewModels"
        xmlns:views="clr-namespace:WinWaechter.App.Views"
        Title="WinWächter"
        Width="1180" Height="780" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Canvas}"
        Foreground="{DynamicResource Ink}"
        FontFamily="{StaticResource TextFont}"
        FontSize="{StaticResource SizeBody}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <views:OverviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OptimizeViewModel}">
            <views:OptimizeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProtectViewModel}">
            <views:ProtectView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrivacyViewModel}">
            <views:PrivacyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProgramsViewModel}">
            <views:ProgramsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation rail -->
        <Border Background="{DynamicResource Rail}">
            <DockPanel LastChildFill="False">
                <!-- Wordmark: a small dial drawn from vector shapes, then the name -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="26,26,16,30">
                    <Grid Width="22" Height="22" VerticalAlignment="Center" AutomationProperties.Name="WinWächter">
                        <Ellipse Stroke="{DynamicResource Ink}" StrokeThickness="1.6" />
                        <Path Data="M11,11 L16.5,5.5" Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeEndLineCap="Round" />
                        <Ellipse Width="4" Height="4" Fill="{DynamicResource Ink}" />
                    </Grid>
                    <TextBlock Margin="11,0,0,0" VerticalAlignment="Center" Text="WinWächter"
                               FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold" />
                </StackPanel>

                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding PrimaryNav}" Focusable="False"
                              KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle"
                              AutomationProperties.Name="Navigation">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         AutomationProperties.Name="{Binding Title}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,18">
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" DataContext="{Binding SettingsNav}"
                                 IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}" />
                    <TextBlock Margin="26,10,16,0" Style="{StaticResource Text.Small}" Text="{Binding Settings.VersionText}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="{DynamicResource WatchSoft}" Padding="32,9"
                    Visibility="{Binding ShowLimitedMode, Converter={StaticResource Vis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="14" Text="{StaticResource GlyphInfo}" Foreground="{DynamicResource Watch}" />
                    <TextBlock Margin="10,0,0,0" Foreground="{DynamicResource Watch}" TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="Ohne Administratorrechte gestartet. Prüfen geht, Änderungen sind gesperrt." />
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Top" Background="{DynamicResource AccentSoft}" Padding="32,8,20,8"
                    Visibility="{Binding Update.ShowBanner, Converter={StaticResource Vis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="{StaticResource GlyphClose}"
                            Command="{Binding Update.DismissBannerCommand}" AutomationProperties.Name="Hinweis ausblenden" ToolTip="Ausblenden" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Quiet}" Content="Ansehen" Margin="0,0,6,0"
                            Command="{Binding ShowUpdateCommand}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="14" Text="{StaticResource GlyphDownload}" Foreground="{DynamicResource Accent}" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Update.AvailableVersionText}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
        </DockPanel>
    </Grid>
</Window>
