<UserControl x:Class="WinWaechter.App.Views.RepairView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinWaechter.App.ViewModels">
    <DockPanel>
        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Canvas}"
                Padding="32,12,32,14" Visibility="{Binding ShowAdminNotice, Converter={StaticResource Vis}}">
            <TextBlock Style="{StaticResource Text.Small}" Foreground="{DynamicResource Watch}" Text="{Binding AdminNotice}" />
        </Border>

        <!-- one scrolling page (no nested scrolling) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="{StaticResource PagePadding}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Button.Quiet}" Content="Neu prüfen"
                            Command="{Binding LoadCommand}" />
                    <TextBlock Style="{StaticResource Text.PageTitle}" Text="Reparatur" />
                </DockPanel>
                <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Prose}"
                           Text="Die üblichen Windows-Reparaturen mit einem Klick. Jede sagt vorher, was passiert und wie lange es dauert; was sich nicht im Verlauf zurücknehmen lässt, ist als endgültig gekennzeichnet." />
                <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Small}" Text="Empfehlungen werden geprüft …"
                           Visibility="{Binding IsChecking, Converter={StaticResource Vis}}" AutomationProperties.LiveSetting="Polite" />

                <Border Margin="0,18,0,0" Style="{StaticResource SurfaceBox}">
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" Margin="0,0,0,-1">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RepairRowViewModel}">
                                <Border Style="{StaticResource RowDivider}" Padding="16,12,16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                <ContentControl Margin="10,0,0,0" Style="{StaticResource Chip}" Tag="{x:Static vm:Tone.Watch}" Content="Empfohlen"
                                                                VerticalAlignment="Center" Visibility="{Binding IsRecommended, Converter={StaticResource Vis}}" />
                                            </StackPanel>
                                            <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Small}" TextWrapping="Wrap"
                                                       MaxWidth="{StaticResource ProseWidth}" HorizontalAlignment="Left" Text="{Binding When}" />
                                            <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Small}" Text="{Binding Facts}" />
                                            <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Small}" Text="{Binding LastRun}" TextWrapping="Wrap"
                                                       MaxWidth="{StaticResource ProseWidth}" HorizontalAlignment="Left" />
                                            <!-- the way out the last run offered (e.g. no repair files: Windows' own „Jetzt neu installieren“) -->
                                            <Button Margin="-8,4,0,0" HorizontalAlignment="Left" Style="{StaticResource Button.Quiet}"
                                                    Content="{Binding LinkText}" Command="{Binding LinkCommand}"
                                                    AutomationProperties.Name="{Binding LinkText}"
                                                    Visibility="{Binding ShowLink, Converter={StaticResource Vis}}" />
                                            <StackPanel Margin="0,6,0,0" Visibility="{Binding ProgressText, Converter={StaticResource Vis}}">
                                                <ProgressBar Style="{StaticResource Scale}" IsIndeterminate="True" MaxWidth="{StaticResource ProseWidth}"
                                                             HorizontalAlignment="Left" Width="320" />
                                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Small}" Text="{Binding ProgressText}"
                                                           AutomationProperties.LiveSetting="Polite" />
                                            </StackPanel>
                                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Small}" TextWrapping="Wrap" MaxWidth="{StaticResource ProseWidth}"
                                                       HorizontalAlignment="Left" Text="{Binding ResultText}"
                                                       Visibility="{Binding ResultText, Converter={StaticResource Vis}}" AutomationProperties.LiveSetting="Polite" />
                                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Small}" Foreground="{DynamicResource Watch}" TextWrapping="Wrap"
                                                       MaxWidth="{StaticResource ProseWidth}" HorizontalAlignment="Left" Text="{Binding LockText}"
                                                       Visibility="{Binding LockText, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource Button.Quiet}" Content="{Binding ButtonText}" Command="{Binding RunCommand}"
                                                    AutomationProperties.Name="{Binding Title}" HorizontalAlignment="Right" />
                                            <Button Margin="0,8,0,0" Style="{StaticResource Button.Quiet}" Content="Abbrechen" Command="{Binding CancelCommand}"
                                                    HorizontalAlignment="Right" ToolTip="Wirkt, sobald DISM fertig ist (vor sfc)."
                                                    Visibility="{Binding ShowCancel, Converter={StaticResource Vis}}" />
                                            <Button Margin="0,8,0,0" Style="{StaticResource Button.Final}" Content="Beim nächsten Neustart reparieren"
                                                    Command="{Binding FixCommand}" HorizontalAlignment="Right"
                                                    Visibility="{Binding ShowFix, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
