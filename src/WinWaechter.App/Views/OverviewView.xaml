<UserControl x:Class="WinWaechter.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinWaechter.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="48,56,48,32" MaxWidth="900" HorizontalAlignment="Left">

            <!-- The one loud element: a plain sentence about the state -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Control Style="{StaticResource ToneMark}" Tag="{Binding StatementTone}" Width="14" Height="14"
                         VerticalAlignment="Top" Margin="0,15,18,0" />
                <TextBlock Grid.Column="1" Style="{StaticResource Text.Statement}" Text="{Binding Statement}" MaxWidth="720"
                           HorizontalAlignment="Left" AutomationProperties.LiveSetting="Polite" />
            </Grid>

            <TextBlock Margin="32,16,0,0" Style="{StaticResource Text.Prose}"
                       Text="„Prüfen“ untersucht Autostarts, Dienste, geplante Aufgaben, Temp-Dateien, Browser- und Windows-Caches, alte Installer, Deinstallationsreste und laufende Programme. Geändert wird erst, wenn Sie eine Vorschau bestätigen." />

            <StackPanel Margin="32,28,0,0" Orientation="Horizontal">
                <Button Style="{StaticResource Button.Large}" Content="Prüfen" Command="{Binding CheckCommand}" />
                <TextBlock Margin="20,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Muted}"
                           Text="{Binding Optimize.ProgressText}" />
            </StackPanel>

            <!-- Readouts on a tick scale -->
            <Rectangle Margin="0,56,0,0" Style="{StaticResource ScaleRule}" />
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Echtzeitschutz" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Control Style="{StaticResource ToneMark}" Tag="{Binding Protect.RealTimeTone}" Margin="0,4,10,0" />
                        <TextBlock Style="{StaticResource Text.Readout}" Text="{Binding Protect.RealTimeText}" />
                    </StackPanel>
                </StackPanel>
                <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource Line}" />

                <StackPanel Grid.Column="2" Margin="20,0,16,0">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Signaturalter" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Control Style="{StaticResource ToneMark}" Tag="{Binding Protect.SignatureTone}" Margin="0,4,10,0" />
                        <TextBlock Style="{StaticResource Text.Readout}" Text="{Binding Protect.SignatureAgeText}" />
                    </StackPanel>
                </StackPanel>
                <Rectangle Grid.Column="3" Width="1" Fill="{DynamicResource Line}" />

                <StackPanel Grid.Column="4" Margin="20,0,16,0">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Letzter Defender-Scan" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.ReadoutText}"
                               Text="{Binding Protect.LastScanText}" />
                </StackPanel>
                <Rectangle Grid.Column="5" Width="1" Fill="{DynamicResource Line}" />

                <StackPanel Grid.Column="6" Margin="20,0,16,0">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Offene Vorschläge" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Readout}" Text="{Binding OpenSuggestionsText}" />
                </StackPanel>
                <Rectangle Grid.Column="7" Width="1" Fill="{DynamicResource Line}" />

                <StackPanel Grid.Column="8" Margin="20,0,16,0">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Sicherheit" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Control Style="{StaticResource ToneMark}" Tag="{Binding SecurityTone}" Margin="0,4,10,0" />
                        <TextBlock Style="{StaticResource Text.ReadoutText}" TextWrapping="Wrap"
                                   Text="{Binding SecurityText}" />
                    </StackPanel>
                </StackPanel>
                <Rectangle Grid.Column="9" Width="1" Fill="{DynamicResource Line}" />

                <StackPanel Grid.Column="10" Margin="20,0,0,0">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Wird frei" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Readout}" Text="{Binding FreeText}" />
                </StackPanel>
            </Grid>

            <TextBlock Margin="0,22,0,0" Style="{StaticResource Text.Small}" Text="{x:Static vm:OverviewViewModel.FreeNote}"
                       Visibility="{Binding Optimize.HasScanned, Converter={StaticResource Vis}}" />

            <TextBlock Margin="0,22,0,0" Style="{StaticResource Text.Small}" Text="{Binding Protect.DefenderNote}"
                       Visibility="{Binding Protect.DefenderNote, Converter={StaticResource Vis}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
